{
  "name": "camunda-modeler-pdf-export",
  "version": "1.0.1",
  "description": "Camunda Desktop Modeler plugin: exports the open BPMN diagram incl. all collapsed subprocesses (any depth) to a landscape A4 PDF.",
  "main": "index.js",
  "private": true,
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "package": "npm run build && node scripts/package.mjs"
  },
  "keywords": [
    "camunda",
    "modeler",
    "plugin",
    "bpmn",
    "pdf"
  ],
  "license": "MIT",
  "dependencies": {
    "jspdf": "^4.2.1",
    "opentype.js": "^1.3.4",
    "svg2pdf.js": "^2.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-react": "^7.27.0",
    "babel-loader": "^10.0.0",
    "camunda-modeler-plugin-helpers": "^7.0.0",
    "webpack": "^5.100.0",
    "webpack-cli": "^6.0.0"
  },
  "files": [
    "index.js",
    "dist",
    "style"
  ]
}
